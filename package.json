{
  "name": "@trustflow/sdk",
  "version": "0.2.1",
  "description": "SDK to interact with TrustFlow Protocol contracts.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./escrow": {
      "types": "./dist/escrow/index.d.ts",
      "import": "./dist/escrow/index.mjs",
      "require": "./dist/escrow/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.mjs",
      "require": "./dist/wallet/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chidubemkingsley/trustflow-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Chidubemkingsley/trustflow-sdk/issues"
  },
  "homepage": "https://github.com/Chidubemkingsley/trustflow-sdk#readme",
  "keywords": [
    "stellar",
    "soroban",
    "trustflow",
    "escrow",
    "smart-contracts",
    "blockchain",
    "sdk",
    "typescript",
    "react"
  ],
  "author": "TrustFlow Protocol",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && node scripts/inject-use-client.js",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "jest --config jest.e2e.config.js",
    "examples": "ts-node examples/",
    "lint": "eslint src",
    "lint:strict": "eslint src --config eslint.strict.config.mjs",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "prepublishOnly": "npm run build",
    "test:bundlers": "node examples/bundlers/verify-bundlers.mjs",
    "examples:multi-account": "esbuild examples/multi-account.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/trustflow-multi-account.cjs --log-level=error && node node_modules/.cache/trustflow-multi-account.cjs"
  },
  "license": "MIT",
  "dependencies": {
    "@stellar/stellar-sdk": "^15.1.0",
    "axios": "^1.18.1",
    "zod": "^3.22.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "esbuild": "^0.25.0",
    "esbuild-loader": "^4.3.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.2",
    "prettier": "^3.8.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.30.0",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "webpack": "^5.97.0",
    "webpack-cli": "^5.1.4"
  }
}
